<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Les projets de tests reçoivent xunit et consorts. Une bibliothèque d'aide qui n'est pas
       un projet de tests (Trofeo.TestDoubles) se déclare avec <IsTestSupportLibrary>true</IsTestSupportLibrary>. -->
  <ItemGroup Condition="'$(IsTestSupportLibrary)' != 'true'">
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- xunit 2, sauf pour un projet qui déclare <UsesXunitV3>true</UsesXunitV3> (xunit v3, référencé par le projet lui-même). -->
  <ItemGroup Condition="'$(IsTestSupportLibrary)' != 'true' And '$(UsesXunitV3)' != 'true'">
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- Sous Linux, SkiaSharp a besoin de sa bibliothèque native (les tests de dessin la chargent). -->
  <ItemGroup Condition="'$(IsTestSupportLibrary)' != 'true' And '$(UsesXunitV3)' != 'true' And $([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
  </ItemGroup>

</Project>
