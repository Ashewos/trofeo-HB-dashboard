<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Trofeo.Core\Trofeo.Core.csproj" />
    <ProjectReference Include="..\..\src\Trofeo.Sensors\Trofeo.Sensors.csproj" />
    <ProjectReference Include="..\..\src\Trofeo.Modules.Agents\Trofeo.Modules.Agents.csproj" />
    <ProjectReference Include="..\..\src\Trofeo.Modules.Monitoring\Trofeo.Modules.Monitoring.csproj" />
    <ProjectReference Include="..\..\src\Trofeo.Modules.NowPlaying\Trofeo.Modules.NowPlaying.csproj" />
    <ProjectReference Include="..\..\src\Trofeo.Modules.Clock\Trofeo.Modules.Clock.csproj" />
    <ProjectReference Include="..\..\src\Trofeo.Modules.Network\Trofeo.Modules.Network.csproj" />
  </ItemGroup>

  <!-- Horloge simulée : l'aperçu avance le temps à la main pour que les modules fassent leurs lectures. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
  </ItemGroup>

  <!-- Sous Linux, SkiaSharp a besoin de sa bibliothèque native (sous Windows, elle vient avec le paquet de base). -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
  </ItemGroup>

</Project>
