<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trofeo.ModuleKit\Trofeo.ModuleKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trofeo.Core.Tests" />
    <InternalsVisibleTo Include="Trofeo.Display" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\*.ttf" LogicalName="Trofeo.Core.Assets.Fonts.%(Filename)%(Extension)" />
    <!-- Les textes de licence OFL suivent les polices dans le dossier de sortie (Assets/Fonts). -->
    <Content Include="Assets\Fonts\OFL-*.txt" Link="Assets\Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
