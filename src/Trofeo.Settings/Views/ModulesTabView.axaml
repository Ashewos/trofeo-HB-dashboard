<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Trofeo.Settings"
             xmlns:vm="clr-namespace:Trofeo.Settings.ViewModels"
             x:Class="Trofeo.Settings.Views.ModulesTabView"
             x:DataType="vm:ModulesTabViewModel">

  <Grid ColumnDefinitions="320,16,*">

    <!-- À gauche : les modules sur l'écran, puis les retirés, chacun avec son point d'état. -->
    <Border Grid.Column="0" Classes="panel" Padding="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" Margin="0,0,8,0">
          <TextBlock Classes="section" Text="{x:Static t:Texts.LayoutOnScreen}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static t:Texts.LayoutEmpty}" IsVisible="{Binding !HasPlaced}" />
          <ListBox Name="PlacedList" Classes="modules" ItemsSource="{Binding Placed}" SelectedItem="{Binding SelectedPlaced}"
                   AutomationProperties.Name="{x:Static t:Texts.LayoutOnScreen}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModuleListItem">
                <Grid ColumnDefinitions="Auto,*">
                  <Ellipse Grid.Column="0" Classes="dot" Margin="0,0,10,0" VerticalAlignment="Center"
                           Classes.online="{Binding IsOnline}" Classes.idle="{Binding IsIdle}" Classes.refuse="{Binding IsRefuse}"
                           AutomationProperties.Name="{Binding HealthText}" ToolTip.Tip="{Binding HealthText}" />
                  <TextBlock Grid.Column="1" Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Classes="section" Margin="0,12,0,0" Text="{x:Static t:Texts.LayoutShelved}" IsVisible="{Binding HasShelved}" />
          <ListBox Name="ShelvedList" Classes="modules" ItemsSource="{Binding Shelved}" SelectedItem="{Binding SelectedShelved}"
                   IsVisible="{Binding HasShelved}" AutomationProperties.Name="{x:Static t:Texts.LayoutShelved}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModuleListItem">
                <Grid ColumnDefinitions="Auto,*">
                  <Ellipse Grid.Column="0" Classes="dot idle" Margin="0,0,10,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- À droite : le module choisi, son état, ses messages, puis son formulaire. -->
    <Border Grid.Column="2" Classes="panel" Padding="24">
      <Panel>
        <TextBlock Name="NothingSelected" Classes="muted" TextWrapping="Wrap" Text="{x:Static t:Texts.ModulesNothingSelected}"
                   IsVisible="{Binding HasNoSelection}" />

        <ScrollViewer IsVisible="{Binding HasSelection}" VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
          <StackPanel Spacing="16" Margin="0,0,16,0">

            <!-- Le nom du module, et son état en mots. -->
            <StackPanel Orientation="Horizontal" Spacing="16">
              <TextBlock Name="ModuleName" Classes="heading" Text="{Binding SelectedName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding HasHealth}">
                <Ellipse Classes="dot" VerticalAlignment="Center"
                         Classes.online="{Binding SelectedOnline}" Classes.idle="{Binding SelectedIdle}" Classes.refuse="{Binding SelectedRefuse}" />
                <TextBlock Name="Health" Classes="lead" VerticalAlignment="Center" Text="{Binding SelectedHealthText}" />
              </StackPanel>
            </StackPanel>

            <!-- Ce que le module dit de lui-même : son message, ses remarques. -->
            <StackPanel Spacing="4" IsVisible="{Binding HasActionMessage}">
              <TextBlock Name="ActionMessage" Classes="warning" TextWrapping="Wrap" Text="{Binding ActionMessage}" />
            </StackPanel>
            <ItemsControl Name="Notices" ItemsSource="{Binding Notices}" IsVisible="{Binding HasNotices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="warning" TextWrapping="Wrap" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Name="NothingToSet" Classes="muted" TextWrapping="Wrap" Text="{x:Static t:Texts.ModulesNothingToSet}"
                       IsVisible="{Binding HasNoSchema}" />

            <ItemsControl Name="Fields" ItemsSource="{Binding Form.VisibleFields}" IsVisible="{Binding HasForm}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="20" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </Border>
  </Grid>
</UserControl>
