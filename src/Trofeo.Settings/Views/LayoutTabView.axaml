<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Trofeo.Settings"
             xmlns:vm="clr-namespace:Trofeo.Settings.ViewModels"
             xmlns:mk="clr-namespace:Trofeo.ModuleKit;assembly=Trofeo.ModuleKit"
             x:Class="Trofeo.Settings.Views.LayoutTabView"
             x:DataType="vm:LayoutTabViewModel">

  <Grid RowDefinitions="Auto,*">

    <!-- Sous la bande : la consigne, ou le motif du refus ; à droite, annuler et rétablir (Ctrl+Z, Ctrl+Y). -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12" MinHeight="36">
      <Panel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static t:Texts.LayoutHint}" IsVisible="{Binding !HasRefusal}" />
        <TextBlock Name="Refusal" Classes="error" TextWrapping="Wrap" Text="{Binding RefusalText}" IsVisible="{Binding HasRefusal}" />
      </Panel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
        <Button Classes="small" Content="{x:Static t:Texts.LayoutUndo}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
        <Button Classes="small" Content="{x:Static t:Texts.LayoutRedo}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="320,16,*">

      <!-- Colonne de gauche : les modules sur l'écran, les modules retirés, et l'ajout. -->
      <Border Grid.Column="0" Classes="panel" Padding="16">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8" Margin="0,0,8,0">
              <TextBlock Classes="section" Text="{x:Static t:Texts.LayoutOnScreen}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static t:Texts.LayoutEmpty}" IsVisible="{Binding !HasPlaced}" />
              <ListBox Classes="modules" ItemsSource="{Binding Placed}" SelectedItem="{Binding SelectedItem}"
                       AutomationProperties.Name="{x:Static t:Texts.LayoutOnScreen}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PlacedModuleItem">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Ellipse Grid.Column="0" Classes="dot" Margin="0,0,10,0" VerticalAlignment="Center"
                               Classes.online="{Binding IsOnline}" Classes.idle="{Binding IsIdle}" Classes.refuse="{Binding IsRefuse}"
                               AutomationProperties.Name="{Binding HealthText}" ToolTip.Tip="{Binding HealthText}" />
                      <TextBlock Grid.Column="1" Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="number muted lead" Margin="12,0,0,0" Text="{Binding SizeText}" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock Classes="section" Margin="0,12,0,0" Text="{x:Static t:Texts.LayoutShelved}" IsVisible="{Binding HasShelved}" />
              <ItemsControl ItemsSource="{Binding Shelved}" IsVisible="{Binding HasShelved}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ShelvedModuleItem">
                    <Border Padding="10,4" Margin="0,0,0,4" CornerRadius="6" Background="{DynamicResource Raised}">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsNotConfirming}">
                          <TextBlock Grid.Column="0" Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Classes="small" Margin="8,0,0,0" Content="{x:Static t:Texts.LayoutRestore}" Command="{Binding RestoreCommand}" />
                          <Button Grid.Column="2" Classes="small" Margin="6,0,0,0" Content="{x:Static t:Texts.LayoutForget}" Command="{Binding AskForgetCommand}" />
                        </Grid>
                        <StackPanel Spacing="6" Margin="0,2" IsVisible="{Binding ConfirmingForget}">
                          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static t:Texts.LayoutForgetConfirm}" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Classes="small danger" Content="{x:Static t:Texts.LayoutForget}" Command="{Binding ConfirmForgetCommand}" />
                            <Button Classes="small" Content="{x:Static t:Texts.LayoutForgetKeep}" Command="{Binding CancelForgetCommand}" />
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <Button Grid.Row="1" Name="AddButton" Classes="primary" Margin="0,12,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="{x:Static t:Texts.LayoutAddModule}" IsEnabled="{Binding CanEdit}">
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedLeft">
                <ItemsControl Name="TypeList" MinWidth="260" ItemsSource="{Binding AddTypes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AddTypeItem">
                      <Button Classes="menu" Content="{Binding Name}" Command="{Binding AddCommand}" Click="OnAddTypeClicked" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Flyout>
            </Button.Flyout>
          </Button>
        </Grid>
      </Border>

      <!-- Colonne de droite : le module choisi. -->
      <Border Grid.Column="2" Classes="panel" Padding="24">
        <Panel>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static t:Texts.LayoutNothingSelected}" IsVisible="{Binding HasNoSelection}" />

          <StackPanel Spacing="20" IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="6">
              <TextBlock Classes="heading" Text="{Binding SelectedName}" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="24">
                <TextBlock Classes="number lead" Text="{Binding SelectedCells}" />
                <TextBlock Classes="number lead" Text="{Binding SelectedPixels}" />
                <TextBlock Classes="number lead muted" Text="{Binding SelectedMinimum}" />
              </StackPanel>
            </StackPanel>

            <WrapPanel Orientation="Horizontal">
              <StackPanel Spacing="8" Margin="0,0,40,16">
                <TextBlock Classes="section" Text="{x:Static t:Texts.LayoutPresets}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Classes="choice" Classes.primary="{Binding IsPresetCompact}" IsEnabled="{Binding HasPresetCompact}"
                          Content="{x:Static t:Texts.LayoutPresetCompact}"
                          Command="{Binding ApplyPresetCommand}" CommandParameter="{x:Static mk:SizePreset.Compact}" />
                  <Button Classes="choice" Classes.primary="{Binding IsPresetIdeal}" IsEnabled="{Binding HasPresetIdeal}"
                          Content="{x:Static t:Texts.LayoutPresetIdeal}"
                          Command="{Binding ApplyPresetCommand}" CommandParameter="{x:Static mk:SizePreset.Ideal}" />
                  <Button Classes="choice" Classes.primary="{Binding IsPresetLarge}" IsEnabled="{Binding HasPresetLarge}"
                          Content="{x:Static t:Texts.LayoutPresetLarge}"
                          Command="{Binding ApplyPresetCommand}" CommandParameter="{x:Static mk:SizePreset.Large}" />
                </StackPanel>
              </StackPanel>

              <StackPanel Spacing="8" Margin="0,0,0,16">
                <TextBlock Classes="section" Text="{x:Static t:Texts.LayoutTextSize}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Classes="choice" Classes.primary="{Binding IsTextSmall}" Content="{x:Static t:Texts.LayoutTextSmall}"
                          Command="{Binding SetTextSizeCommand}" CommandParameter="{x:Static mk:TextSize.Small}" />
                  <Button Classes="choice" Classes.primary="{Binding IsTextNormal}" Content="{x:Static t:Texts.LayoutTextNormal}"
                          Command="{Binding SetTextSizeCommand}" CommandParameter="{x:Static mk:TextSize.Normal}" />
                  <Button Classes="choice" Classes.primary="{Binding IsTextLarge}" Content="{x:Static t:Texts.LayoutTextLarge}"
                          Command="{Binding SetTextSizeCommand}" CommandParameter="{x:Static mk:TextSize.Large}" />
                </StackPanel>
              </StackPanel>
            </WrapPanel>

            <Button HorizontalAlignment="Left" Content="{x:Static t:Texts.LayoutRemove}" Command="{Binding RemoveSelectedCommand}" />
          </StackPanel>
        </Panel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
