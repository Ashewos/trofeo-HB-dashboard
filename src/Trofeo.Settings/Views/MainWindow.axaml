<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:Trofeo.Settings"
        xmlns:vm="clr-namespace:Trofeo.Settings.ViewModels"
        xmlns:controls="clr-namespace:Trofeo.Settings.Controls"
        x:Class="Trofeo.Settings.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{x:Static t:Texts.WindowTitle}"
        Width="1440" Height="900" MinWidth="1200" MinHeight="760"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <!-- En-tête : le nom, les cinq onglets, la pastille de l'écran. -->
    <Border Grid.Row="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,0" Height="64">
        <TextBlock Grid.Column="0" Classes="heading" Text="{x:Static t:Texts.AppName}"
                   VerticalAlignment="Center" Margin="0,0,32,0" />

        <ListBox Grid.Column="1" Classes="tabs" VerticalAlignment="Center"
                 AutomationProperties.Name="{x:Static t:Texts.TabsName}"
                 ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TabViewModel">
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="2" Classes="pill" VerticalAlignment="Center"
                Classes.amber="{Binding PillAmber}"
                AutomationProperties.Name="{Binding PillText}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Classes="dot" VerticalAlignment="Center"
                     Classes.online="{Binding PillOnline}" Classes.idle="{Binding PillIdle}"
                     Classes.amber="{Binding PillAmber}" Classes.refuse="{Binding PillRefuse}" />
            <TextBlock Text="{Binding PillText}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- L'écran en direct, sur toute la largeur et dans tous les onglets. -->
    <Grid Grid.Row="1" Margin="24,20,24,0">
      <controls:ScreenStrip Name="Strip"
                            AutomationProperties.Name="{x:Static t:Texts.StripName}"
                            Source="{Binding PreviewImage}" Rotation="{Binding PreviewRotation}" />
      <!-- Dans l'onglet Disposition, le damier se pose sur la bande et on y travaille directement. -->
      <controls:GridOverlay Strip="{Binding #Strip}" Model="{Binding LayoutTab}" IsVisible="{Binding IsGridVisible}"
                            AutomationProperties.Name="{x:Static t:Texts.LayoutGridName}" />
    </Grid>

    <!-- Une ligne Amber sous la bande, dans tous les onglets : le message de la dernière modification, les avertissements hors apparence. -->
    <TextBlock Grid.Row="2" Name="SaveMessage" Classes="warning" TextWrapping="Wrap" Margin="24,12,24,0"
               Text="{Binding SaveMessage}" IsVisible="{Binding HasSaveMessage}" />

    <!-- Le contenu de l'onglet choisi, ou le panneau « service arrêté ». -->
    <Grid Grid.Row="3" Margin="24,16,24,24">
      <ContentControl Name="TabContent" Content="{Binding SelectedTab}" IsVisible="{Binding !IsStopped}" />

      <Border Classes="panel" IsVisible="{Binding IsStopped}" Padding="32"
              HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="560">
        <StackPanel Spacing="20">
          <TextBlock Classes="lead" TextWrapping="Wrap" Text="{x:Static t:Texts.ServiceStoppedMessage}" />
          <Button Classes="primary" HorizontalAlignment="Left"
                  Content="{x:Static t:Texts.StartService}" Command="{Binding StartServiceCommand}" />
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{x:Static t:Texts.ServiceNotFound}"
                     IsVisible="{Binding StartFailed}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
