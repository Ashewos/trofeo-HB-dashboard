<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Trofeo.Settings"
             xmlns:f="clr-namespace:Trofeo.Settings.ViewModels.Fields"
             x:Class="Trofeo.Settings.Views.Fields.SecretFieldView"
             x:DataType="f:SecretFieldViewModel">

  <!-- Seulement « Enregistrée » ou « Absente » : la valeur ne s'affiche jamais. La saisie est masquée. -->
  <StackPanel Spacing="8">
    <TextBlock Classes="section" Text="{Binding Label}" />

    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsNotEditing}">
      <Ellipse Classes="dot" VerticalAlignment="Center" Classes.online="{Binding IsPresent}" />
      <TextBlock Name="Status" VerticalAlignment="Center" MinWidth="80" Text="{Binding StatusText}" />
      <Button Name="EditButton" Classes="small" Content="{x:Static t:Texts.ModulesSecretEdit}" Command="{Binding EditCommand}" />
    </StackPanel>

    <StackPanel Spacing="8" IsVisible="{Binding IsEditing}">
      <TextBox Name="Box" HorizontalAlignment="Left" Width="420" PasswordChar="●"
               AutomationProperties.Name="{Binding Label}" Text="{Binding Input}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="SaveButton" Classes="primary small" Content="{x:Static t:Texts.ModulesSecretSave}"
                Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
        <Button Name="ClearButton" Classes="small danger" Content="{x:Static t:Texts.ModulesSecretClear}"
                Command="{Binding ClearCommand}" IsEnabled="{Binding CanClear}" />
        <Button Name="CancelButton" Classes="small" Content="{x:Static t:Texts.ModulesCancel}" Command="{Binding CancelCommand}" />
      </StackPanel>
    </StackPanel>

    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Help}" IsVisible="{Binding HasHelp}" />
    <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
  </StackPanel>
</UserControl>
