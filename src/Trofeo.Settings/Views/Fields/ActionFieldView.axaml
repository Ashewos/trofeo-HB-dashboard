<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Trofeo.Settings"
             xmlns:f="clr-namespace:Trofeo.Settings.ViewModels.Fields"
             x:Class="Trofeo.Settings.Views.Fields.ActionFieldView"
             x:DataType="f:ActionFieldViewModel">

  <!-- Un bouton ; sa question de confirmation, si le schéma en pose une ; puis le message de l'action. -->
  <StackPanel Spacing="8">
    <Button Name="RunButton" HorizontalAlignment="Left" Content="{Binding ButtonText}"
            Command="{Binding RequestCommand}" IsEnabled="{Binding CanRun}" IsVisible="{Binding IsNotConfirming}" />

    <Border Name="Confirm" Classes="note" IsVisible="{Binding IsConfirming}" MaxWidth="520" HorizontalAlignment="Left">
      <StackPanel Spacing="12">
        <TextBlock TextWrapping="Wrap" Text="{Binding ConfirmText}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Name="ConfirmButton" Classes="primary small" Content="{Binding Label}" Command="{Binding ConfirmCommand}" />
          <Button Name="CancelButton" Classes="small" Content="{x:Static t:Texts.ModulesCancel}" Command="{Binding CancelConfirmCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock Name="Result" TextWrapping="Wrap" Text="{Binding Message}" IsVisible="{Binding HasMessage}"
               Classes.ok="{Binding IsOk}" Classes.error="{Binding IsFailed}" />
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static t:Texts.ModulesActionShelved}" IsVisible="{Binding IsUnavailable}" />
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Help}" IsVisible="{Binding HasHelp}" />
    <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
  </StackPanel>
</UserControl>
