<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:f="clr-namespace:Trofeo.Settings.ViewModels.Fields"
             x:Class="Trofeo.Settings.Views.Fields.ChoiceFieldView"
             x:DataType="f:ChoiceFieldViewModel">

  <!-- Jusqu'à 3 options : des boutons segmentés ; au-delà : une liste déroulante. -->
  <StackPanel Spacing="8">
    <TextBlock Classes="section" Text="{Binding Label}" />

    <ItemsControl Name="Segments" ItemsSource="{Binding Options}" IsVisible="{Binding IsSegmented}"
                  AutomationProperties.Name="{Binding Label}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="f:ChoiceOptionItem">
          <Button Classes="choice" Classes.primary="{Binding IsSelected}" Margin="0,0,6,6"
                  Content="{Binding Label}" Command="{Binding SelectCommand}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <ComboBox Name="DropDown" MinWidth="280" HorizontalAlignment="Left" IsVisible="{Binding IsDropDown}"
              AutomationProperties.Name="{Binding Label}"
              ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="f:ChoiceOptionItem">
          <TextBlock Text="{Binding Label}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Help}" IsVisible="{Binding HasHelp}" />
    <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
  </StackPanel>
</UserControl>
