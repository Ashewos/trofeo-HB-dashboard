<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Trofeo.Settings"
             xmlns:vm="clr-namespace:Trofeo.Settings.ViewModels"
             x:Class="Trofeo.Settings.Views.SensorsBlock"
             x:Name="Root"
             x:DataType="vm:SettingsTabViewModel">

  <!-- L'état en une phrase, le bouton d'installation (tant que les capteurs ne sont pas actifs), puis le résultat de l'installation. -->
  <StackPanel Spacing="10">
    <TextBlock Name="SensorsText" Classes="lead" TextWrapping="Wrap" Text="{Binding SensorsText}" />
    <Button Name="InstallSensors" HorizontalAlignment="Left" Classes.primary="{Binding #Root.Primary}"
            Content="{x:Static t:Texts.SensorsInstall}" Command="{Binding InstallSensorsCommand}"
            IsVisible="{Binding CanInstallSensors}" />
    <TextBlock Name="SensorsMessage" TextWrapping="Wrap" Text="{Binding SensorsMessage}" IsVisible="{Binding HasSensorsMessage}"
               Classes.error="{Binding SensorsMessageIsError}" Classes.muted="{Binding !SensorsMessageIsError}" />
  </StackPanel>
</UserControl>
